# Apify — https://console.apify.com => Settings => API & Integrations
# If APIFY_TOKEN is left empty the app runs in MOCK mode (fake jobs, no cost)
# APIFY_TOKEN=
APIFY_TOKEN=
# Apify actor ids, e.g. "bebity/linkedin-jobs-scraper" or "user~my-actor"
APIFY_LINKEDIN_ACTOR_ID=
APIFY_UPWORK_ACTOR_ID=

# Telegram — create a bot with @BotFather, send it a message, then get your
# chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=8787
