# Apify — https://console.apify.com => Settings => API & Integrations
# If APIFY_TOKEN is left empty the app runs in MOCK mode (fake jobs, no cost)
APIFY_TOKEN=
# Apify actor ids, e.g. "curious_coder/linkedin-jobs-scraper" or "user~my-actor"
APIFY_LINKEDIN_ACTOR_ID=
APIFY_UPWORK_ACTOR_ID=
# LinkedIn session cookie required by some actors, as JSON array:
# LINKEDIN_COOKIES=[{"name":"li_at","value":"paste-your-cookie-value"}]
LINKEDIN_COOKIES=

# Telegram — create a bot with @BotFather, send it a message, then get your
# chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=job_app

PORT=8787
