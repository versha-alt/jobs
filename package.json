{
  "name": "job-alert-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Keyword-based LinkedIn & Upwork job monitoring via Apify scrapers, delivered as CSV files to Telegram on scheduled triggers",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "apify-client": "^2.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "framer-motion": "^12.4.0",
    "vite": "^6.1.0"
  }
}
